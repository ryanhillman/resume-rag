# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.
#
# Only the variables without defaults are listed; see variables.tf for the rest.

ssh_public_key = "ssh-rsa AAAA..."

# Restrict SSH to your own address. Leaving it as "*" exposes SSH to the public internet.
allowed_ssh_cidr = "203.0.113.0/32"   # replace with your IP

# Ports 80 and 443 stay open: Caddy can obtain and renew its certificate only
# while the internet can reach them. Sign-in protects the app.
allowed_app_cidr = "*"

# Override if "<prefix>-ai" is already taken (must be globally unique worldwide)
# ai_custom_subdomain = "resume-rag-ai-yourname"
