# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

prefix              = "resume-rag"
resource_group_name = "resume-rag-rg"
location            = "eastus"
vm_size             = "Standard_B1s"
os_disk_size_gb     = 64
admin_username      = "azureuser"
ssh_public_key      = "ssh-rsa AAAA..."

# Restrict both to your office/VPN CIDR. Leaving as "*" exposes SSH and the
# app (which handles private resume data) to the public internet.
allowed_ssh_cidr = "203.0.113.0/32"   # replace with your IP
allowed_app_cidr = "203.0.113.0/24"   # replace with your office/VPN range

# Override if "<prefix>-ai" is already taken (must be globally unique worldwide)
# ai_custom_subdomain = "resume-rag-ai-yourname"

# gh api repos/<owner>/<repo>/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_subject_prefix = "repo:<owner>@<owner-id>/<repo>@<repo-id>"
